{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forma",
  "version": "0.1.7",
  "identifier": "io.github.kingvic300.forma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Forma",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "maximized": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://*.supabase.co https://*.supabase.in",
        "frame-src": "'self'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Docs, Sheets, Forms, PDF and Tracker in one offline app",
    "longDescription": "Forma is an offline desktop office suite. Write documents, open and edit CSV and Excel spreadsheets, build forms and collect responses, edit, fill and sign PDFs, and track tasks and habits. Your files stay on your computer.",
    "license": "MIT",
    "copyright": "Copyright (c) Forma contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF document", "role": "Editor", "mimeType": "application/pdf" },
      { "ext": ["csv", "tsv"], "name": "CSV spreadsheet", "role": "Editor", "mimeType": "text/csv" },
      { "ext": ["xlsx", "xls", "ods"], "name": "Spreadsheet", "role": "Editor" },
      { "ext": ["docx"], "name": "Word document", "role": "Editor" }
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils"
      },
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "homepage": "https://github.com/Kingvic300/Forma",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFODlGRDUzRDlFMzlBMTEKUldRUm11UFpVLzJKM3JWZUtZUDAxTjFLUTRtUytBYnI3Um9aaUtPY296Z2liZmw3bEMreklicU4K",
      "endpoints": ["https://github.com/Kingvic300/Forma/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
